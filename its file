            const copyBtnText = document.getElementById("copyBtnText");
            const copyBtn = document.getElementById("copyBtn");

            // Show floating toast
            toast.classList.remove("opacity-0", "-translate-y-4");
            toast.classList.add("opacity-100", "translate-y-0");

            // Update button state
            copyBtnText.textContent = "কপি হয়েছে! (@WDBRAKER)";
            copyBtn.classList.add("border-emerald-500/60", "text-emerald-300");

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove("opacity-100", "translate-y-0");
                toast.classList.add("opacity-0", "-translate-y-4");

                copyBtnText.textContent = "আইডি কপি করো";
                copyBtn.classList.remove("border-emerald-500/60", "text-emerald-300");
            }, 3000);
        }
    </script>
</body>
</html>
